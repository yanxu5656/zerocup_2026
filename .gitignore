# 构建产物（由 tools/pack-release.ps1 生成，可随时重建）
dist/
*.zip

# 临时目录
_tmp/
.tmp/

# DSH 沙箱改权限的备份与回滚记录（本机专用，不入库）
_acl-recovery/

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 本地参考资料（其他模型的同题 demo，不参与提交）
TEST/

# 助手工作目录（本地记忆与缓存，不入库）
.workbuddy/

# 官方资料与 Office 临时文件（大二进制走网盘共享，不入库）
资料/*.docx
资料/*.pptx
资料/~$*

# 本地服务产生的成绩数据，不入库
server/data/
